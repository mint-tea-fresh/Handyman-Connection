# Jobber Developer Center application credentials
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Public HTTPS URL. On Render this is discovered from RENDER_EXTERNAL_URL.
APP_BASE_URL=http://localhost:8000

# Generate strong values; never commit production values.
# APP_ENCRYPTION_KEY accepts a Fernet key or any random value of 32+ characters.
APP_ENCRYPTION_KEY=
MCP_API_KEY=

# Local development. Render supplies its managed Postgres URL.
DATABASE_URL=sqlite:///./jobber_mcp.db
EXPORT_DIR=exports
JOBBER_API_VERSION=2025-04-16
